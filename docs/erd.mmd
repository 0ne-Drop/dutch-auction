erDiagram
  brand ||--o{ auction : "하루 1브랜드"
  auction ||--|{ item : "포함"
  item ||--o| award : "낙찰 시에만"
  app_user ||--o{ award : "낙찰"
  brand {
    uuid brand_id PK
    text name UK
    timestamptz created_at
  }
  auction {
    uuid auction_id PK
    uuid brand_id FK
    date auction_date UK "하루 1회차"
    timestamptz starts_at "공통 시작"
    timestamptz ends_at
    integer price_drop_interval_sec "인하 주기"
    timestamptz created_at
  }
  item {
    uuid item_id PK
    uuid auction_id FK
    text name
    text category "outer top bottom shoes acc"
    text image_url "대표 이미지"
    numeric start_price "시작가"
    numeric min_price "최소 입찰가"
    text status "listed / sold / unsold"
    timestamptz created_at
    timestamptz deleted_at "nullable"
  }
  award {
    uuid item_id PK,FK
    text item_status FK "항상 sold"
    uuid winner_user_id FK
    numeric winning_price "낙찰가"
    timestamptz won_at "낙찰 일시"
  }
  app_user {
    uuid app_user_id PK
    text login_id UK
    text password_hash
    timestamptz created_at
    timestamptz deleted_at "nullable"
  }
