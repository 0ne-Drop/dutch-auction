# 로컬 실행용 RDS 접속 정보. 이 파일을 .env 로 복사해서 값을 채운다 (.env 는 커밋하지 않음).
#
# RDS 는 프라이빗 서브넷에 있어서 Bastion SSH 터널을 먼저 연다.
#   ssh -N -L 15432:<RDS 엔드포인트>:5432 ec2-user@<Bastion 공인 IP>
#
# 사용처
#   - docker compose: DATABASE_USERNAME, DATABASE_PASSWORD 만 읽는다 (DATABASE_URL 은 docker-compose.yml 에 있음)
#   - ./gradlew bootRun: 셸에 불러와서 실행한다
#       set -a; source ../.env; set +a; ./gradlew bootRun
#
# RDS 는 SSL 접속만 받으므로 sslmode=require 를 유지한다.
DATABASE_URL=jdbc:postgresql://localhost:15432/OnedropDB?sslmode=require
DATABASE_USERNAME=
DATABASE_PASSWORD=
